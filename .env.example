# Copy to .env — read by `docker compose` and by `uv run --env-file .env`.

# Shared secret between the app and the LiteLLM gateway (any random string): openssl rand -hex 32
LITELLM_MASTER_KEY=
# Bearer token for POST /ingest; leave empty to keep ingestion closed: openssl rand -hex 32
INGEST_KEY=
# Provider key for the "chat" alias in litellm.yaml (not needed if you switch chat to a local model)
DEEPSEEK_API_KEY=

# One line describing your documents; drives the relevance gate and the system prompt
# KB_TOPIC=Northwind Labs' employee handbook (leave, remote work, travel, IT, benefits)

# Optional overrides
# CHAT_MODEL=chat
# GATE_MODEL=chat
# EMBED_MODEL=embedding
# EMBED_DIM=1024
# EMBED_QUERY_PREFIX=          # set empty for embedding models that don't use an instruction prefix
# LITELLM_URL=http://localhost:4000
# QDRANT_URL=http://localhost:6333
# DB_PATH=app.db
